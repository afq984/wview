load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

rust_binary(
    name = "wview",
    srcs = ["src/main.rs"],
    # The vite-built bundle is a compile-time input: src/main.rs embeds it via
    # include_bytes!(env!("WVIEW_JS")). rules_rust expands $(execpath) in
    # rustc_env to an absolute path inside the rustc action's sandbox.
    compile_data = ["//web:bundle_js"],
    edition = "2021",
    rustc_env = {"WVIEW_JS": "$(execpath //web:bundle_js)"},
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "wview_unit",
    size = "small",
    compile_data = ["//web:bundle_js"],
    crate = ":wview",
    rustc_env = {"WVIEW_JS": "$(execpath //web:bundle_js)"},
)

sh_test(
    name = "integration",
    size = "small",
    srcs = ["tests/integration_test.sh"],
    # Needs host bash/coreutils/curl — accepted host tools alongside the C
    # toolchain.
    data = [":wview"],
)
