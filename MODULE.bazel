"""wview: single-binary local code browser.

Build and test everything with `bazel test //...`; run with
`bazel run //:wview -- <dir> [port]`. Cargo.toml/Cargo.lock stay the source
of truth for Rust dependencies (consumed by crate_universe).
"""

module(
    name = "wview",
    version = "0.0.0",
)

bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "aspect_rules_js", version = "3.3.1")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2021")
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")

# Playwright browsers, fetched by Bazel rather than a post-install step.
# Pinned below 1.57: rules_playwright 0.5.3 only generates the legacy
# builds/chromium/<revision>/ download paths, which stop resolving for 1.57+
# on x64. browsers.json is vendored so the browser revision is a committed
# input rather than an unhashed remote fetch.
bazel_dep(name = "rules_playwright", version = "0.5.3")

playwright = use_extension("@rules_playwright//playwright:extensions.bzl", "playwright")
playwright.repo(
    name = "playwright",
    browsers_json = "//web:browsers.json",
    # rules_playwright 0.5.3 ships no integrity for revision 1194, so pin the
    # archive this project actually fetches (verified via Bazel's canonical
    # integrity report). Other platforms: add their hash on first use.
    integrity_path_map = {
        "builds/chromium/1194/chromium-headless-shell-linux.zip": "sha256-10XHIQzIi3PHmRoiyWJIGZYNhLw953rHM20t6EGoyR8=",
    },
)
use_repo(playwright, "playwright")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//web:pnpm-lock.yaml",
)
use_repo(npm, "npm")
